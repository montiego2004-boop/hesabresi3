{
  "name": "daneh-hesab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:offline": "npm run build && node tests/offline.mjs",
    "test:deployed": "node scripts/verify-deployment.mjs",
    "test:android": "node scripts/verify-android.mjs",
    "package:netlify": "npm run build && node scripts/package-site.mjs",
    "format": "prettier --write src scripts tests docs *.md *.ts *.json"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.550.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "143.0.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.0",
    "fflate": "^0.8.3",
    "playwright-core": "^1.56.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
